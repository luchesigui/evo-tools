# Credenciais do Kommo CRM (API v4)
KOMMO_DOMAIN=pbsjcsatelite.kommo.com
KOMMO_CLIENT_ID=seu_client_id_aqui
KOMMO_CLIENT_SECRET=seu_client_secret_aqui
KOMMO_ACCESS_TOKEN=seu_access_token_aqui
KOMMO_REFRESH_TOKEN=seu_refresh_token_aqui

# Chats API (amojo) - Obtidos ao registrar um chat channel no Kommo
# Para obter: Configurações → Integrações → Criar integração privada → Chat channel
KOMMO_CHANNEL_ID=seu_channel_id_aqui
KOMMO_CHANNEL_SECRET=seu_channel_secret_aqui
KOMMO_SCOPE_ID=seu_scope_id_aqui

# Arquivo XLSX com telefones
XLSX_FILE_PATH=/Users/guilhermeluchesi/Desktop/contatos.xlsx

# Mensagem a ser enviada (suporta templates com {nome})
MESSAGE_TEXT=Olá {nome}! Mensagem de teste do Evo Tools.

# Sales Bots IDs (Kommo) para cobrança por janela de atraso
# Configure estes IDs no Kommo em: Configurações → Automações → Sales Bots
SALES_BOT_COBRANCA_1DIA=seu_bot_id_1dia_aqui
SALES_BOT_COBRANCA_3DIAS=seu_bot_id_3dias_aqui
SALES_BOT_COBRANCA_7DIAS=seu_bot_id_7dias_aqui